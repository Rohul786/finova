# Port for Finova Backend API
PORT=5000

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Optional: Host URL for self-referential links or OAuth
APP_URL="http://localhost:3000"

# EMAIL_API_KEY or RESEND_API_KEY: API Key for sending real verification emails (e.g. Resend, SendGrid)
RESEND_API_KEY=
EMAIL_API_KEY=
EMAIL_FROM="Finova Security <security@finova.ai>"

# Optional SMTP Settings (if using custom SMTP provider)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
